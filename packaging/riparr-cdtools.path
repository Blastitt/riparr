[Unit]
Description=Watch for a Riparr request to install the music CD tools
Documentation=https://github.com/jackharvest/riparr

[Path]
# Same one-way door as riparr-dvdtools.path: the web service can create this file and
# nothing else. What runs is fixed in riparr-cdtools.service.
PathExists=/run/riparr/cdtools.request

[Install]
WantedBy=multi-user.target
